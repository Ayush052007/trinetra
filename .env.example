# ===========================================================================
# TRINETRA configuration template.
# Copy to .env and fill in. Never commit the resulting .env.
# ===========================================================================

# development | production | test
ENVIRONMENT=development

# REQUIRED in production - the app refuses to start without it.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Storage ---------------------------------------------------------------
# SQLite by default so the platform runs with no external service.
# PostgreSQL is a drop-in replacement:
#   DATABASE_URL=postgresql+psycopg://trinetra:password@localhost:5432/trinetra
DATABASE_URL=sqlite:///./trinetra.db
MAX_UPLOAD_MB=25

# --- Knowledge graph -------------------------------------------------------
# "embedded" runs the in-process pure-Python graph engine (no external service).
# "neo4j" switches every graph call to real Cypher against the instance below.
GRAPH_BACKEND=embedded
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Session and lockout policy --------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=8
REMEMBER_ME_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=300
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Deployment identity (shown in the UI) ---------------------------------
DEPLOYMENT_ORG=National Crime Records Bureau
DEPLOYMENT_DIVISION=Women Safety Division
DEPLOYMENT_UNIT=Criminal Network Intelligence Unit

# --- Data classification ---------------------------------------------------
# Keep SYNTHETIC until the deployment loads authorised operational data.
# The classification banner is a data-integrity control, not decoration.
DATA_CLASSIFICATION=SYNTHETIC
SHOW_CLASSIFICATION_BANNER=true

# --- Maps ------------------------------------------------------------------
# Empty = fully offline self-contained renderer (default).
# Set to an XYZ tile template to overlay real tiles when online, e.g.
#   MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#   MAP_ATTRIBUTION=(c) OpenStreetMap contributors
MAP_TILE_URL=
MAP_ATTRIBUTION=

# --- External integrations -------------------------------------------------
# All false. These are structured but NOT connected - each requires
# authorisation and configuration before it can be enabled.
# See docs/INTEGRATIONS.md.
ENABLE_DEVICE_GPS=false
ENABLE_EMERGENCY_DISPATCH=false
ENABLE_SMS_GATEWAY=false
ENABLE_TELECOM_CDR_FEED=false
ENABLE_RTO_LOOKUP=false
ENABLE_CCTNS_SYNC=false
